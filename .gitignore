
# =============================================================================
# Heart-Care App — .gitignore
# Monorepo: Flutter (mobile/) + Spring Boot (backend/)
# =============================================================================


# =============================================================================
# AI ASSISTANT TOOLING — workspace tooling & generated artifacts, not project code
# =============================================================================

# Claude Code
# .claude/settings.json IS committed so every contributor runs the same plugin
# set; everything else under .claude/ (incl. settings.local.json) stays local.
.claude/*
!.claude/settings.json
.auto-memory/
# The root CLAUDE.md is local-only, but mobile/CLAUDE.md IS committed so the
# frontend team gets the project rules from a plain clone.
CLAUDE.md
!mobile/CLAUDE.md
docs/superpowers/

# Codebase memory / MCP
.codebase-memory/
.mcp.json

# Other AI assistants
GEMINI.md
AGENTS.md
.cursor/
.cursorrules
.aider*
.github/copilot-instructions.md


BUGS.md
BUGS_RESOLVE.md


# =============================================================================
# DOCKER
# =============================================================================

# Docker override files (local machine-specific overrides)
docker-compose.override.yml
docker-compose.local.yml

# Docker build artifacts
.dockerignore.local


# =============================================================================
# SECRETS & CREDENTIALS — never commit these under any circumstances
# =============================================================================

# .env          → GITIGNORED  (real credentials — never commit)
# .env.example  → COMMITTED   (template with placeholder values — safe to commit)
.env
.env.*
!.env.example
*.env
application-prod.yml          # Production DB/JWT secrets — use Railway env vars
application-prod.properties   # Same as above but .properties format
application-secrets.yml
application-secrets.properties
application-local.properties  # Local overrides that may contain dev secrets
secrets.yml
secrets.json

# Android signing keys
android/key.properties
*.keystore
*.jks

# iOS signing
*.p12
*.mobileprovision

# Firebase (if added later)
google-services.json
GoogleService-Info.plist


# =============================================================================
# FLUTTER / DART
# =============================================================================

# Dart tool cache
.dart_tool/
.packages
.pub-cache/
.pub/

# Flutter plugin files (auto-generated on flutter pub get)
.flutter-plugins
.flutter-plugins-dependencies

# Flutter build output
mobile/build/

# Generated files
# Trailing comments are NOT valid gitignore syntax - patterns stay bare.
# Generated code is not committed; run:
#   dart run build_runner build --delete-conflicting-outputs
*.g.dart
*.freezed.dart

# Android (inside mobile/)
mobile/android/.gradle/
mobile/android/captures/
mobile/android/local.properties
mobile/android/GeneratedPluginRegistrant.java

# iOS (inside mobile/)
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Flutter.framework
mobile/ios/Flutter/Flutter.podspec
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Flutter/app.flx
mobile/ios/Flutter/app.zip
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/ServiceDefinitions.json
mobile/ios/Runner/GeneratedPluginRegistrant.*

# iOS CocoaPods lockfile (team preference: either commit or ignore — pick one)
# mobile/ios/Podfile.lock


# =============================================================================
# SPRING BOOT / JAVA / MAVEN
# =============================================================================

# Maven build output
backend/target/

# Compiled class files
*.class

# Package files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Maven wrapper jar (the .properties file should be committed, not the jar)
.mvn/wrapper/maven-wrapper.jar

# Spring Boot application properties
# COMMIT:   application.properties         (base config, no secrets)
#           application-dev.yml/.properties (safe dev defaults, no passwords)
# IGNORE:   everything below — these contain real credentials
backend/src/main/resources/application-prod.properties
backend/src/main/resources/application-prod.yml
backend/src/main/resources/application-local.properties
backend/src/main/resources/application-secrets.properties

# Log files generated by Spring Boot
*.log
logs/

# Spring Boot DevTools restart trigger
.reloadtrigger


# =============================================================================
# IDEs & EDITORS
# =============================================================================

# IntelliJ IDEA / Android Studio
.idea/
*.iml
*.ipr
*.iws
out/
.idea_modules/

# VS Code
.vscode/
*.code-workspace

# Eclipse
.classpath
.project
.settings/
bin/

# NetBeans
nbproject/
nbbuild/
nbdist/
.nb-gradle/


# =============================================================================
# OPERATING SYSTEM
# =============================================================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~


# =============================================================================
# MISCELLANEOUS
# =============================================================================

# Dependency directories (if any Node tooling is added, e.g. for docs)
node_modules/

# Coverage reports
coverage/
*.lcov
htmlcov/

# Test result files
test-results/
*.xml.test

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
