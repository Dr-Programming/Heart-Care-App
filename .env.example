# =============================================================================
# Heart-Care App — ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in real values. The real .env is gitignored.
#   cp .env.example .env
# NEVER put real secrets in this file — placeholders only.
# =============================================================================

# PostgreSQL (consumed by docker-compose.yml)
POSTGRES_DB=heartcare
POSTGRES_USER=heartcare
POSTGRES_PASSWORD=replace-with-a-strong-password

# Backend JWT signing secret — REQUIRED, must be at least 32 bytes.
# No profile supplies a default: the app refuses to start without this, by design, so that a
# deploy which forgets it fails loudly instead of signing real tokens with a well-known key.
# Note that docker-compose reads this file but `mvn spring-boot:run` does not — export it.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# Comma-separated CORS origins. Defaults to http://localhost:* when unset, which is correct for
# local dev and for the native mobile client (CORS does not apply to native HTTP clients).
# Set explicitly in production if any browser-based client needs access.
CORS_ALLOWED_ORIGINS=http://localhost:*

# Admin panel (admin-web, http://localhost:3000) — read-only view of all patient data.
# The backend creates this account on startup if it doesn't exist; it never overwrites it.
# Leave either blank to skip. Password must be at least 12 characters or the backend won't start.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-admin-password

# Research access (research-web, http://localhost:3001). REQUIRED, at least 32 bytes.
# HMAC key for the patient codes researchers see (P-XXXXXXXX). Keep it stable: changing it gives
# every patient a new code, breaking any notes researchers kept against the old ones.
# Generate one with:  openssl rand -base64 48
RESEARCH_PSEUDONYM_SECRET=replace-with-a-random-secret-at-least-32-bytes-long

# -----------------------------------------------------------------------------
# System Control Centre (monitoring dashboard, http://localhost:3002). Only needed when running
#   docker compose -f docker-compose.yml -f docker-compose.monitoring.yml up -d --build
# See monitoring/README.md.
# -----------------------------------------------------------------------------
# Password for the read-only `monitoring_user` that postgres-exporter connects with. REQUIRED.
MONITORING_DB_PASSWORD=replace-with-a-strong-password
# SCC's own login, separate from the admin panel. Password must be at least 12 characters.
SCC_ADMIN_USERNAME=scc-admin
SCC_ADMIN_PASSWORD=replace-with-a-long-scc-password
# Signs SCC session tokens. REQUIRED, at least 32 bytes. Generate with:  openssl rand -base64 48
SCC_JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
# ngrok's local agent API, used for the tunnel status card. The default reaches the host's ngrok.
NGROK_API_URL=http://host.docker.internal:4040/api/tunnels
